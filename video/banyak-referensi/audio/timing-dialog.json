 "cues": [
  {
   "start": 0.4,
   "end": 3.858,
   "text": "Selamat datang di kisah kedua kita.",
   "scene": 1,
   "line": "s01-l1"
  },
  {
   "start": 15,
   "end": 18.297,
   "text": "Saya mencari bacaan tentang tempo kelompok kami,",
   "scene": 2,
   "line": "s02-l1"
  },
  {
   "start": 18.377,
   "end": 21.043,
   "text": "tetapi malah bingung memilih.",
   "scene": 2,
   "line": "s02-l1"
  },
  {
   "start": 21.123,
   "end": 25.561,
   "text": "Buka lagi catatanmu. Apa yang ingin kamu pahami?",
   "scene": 2,
   "line": "s02-l2"
  },
  {
   "start": 30,
   "end": 31.977,
   "text": "Apa kata kuncimu?",
   "scene": 3,
   "line": "s03-l1"
  },
  {
   "start": 32.057,
   "end": 33.781,
   "text": "«Musik», Prof.",
   "scene": 3,
   "line": "s03-l2"
  },
  {
   "start": 33.861,
   "end": 37.306,
   "text": "Persempit: siswa pemula, ansambel, dan koordinasi tempo.",
   "scene": 3,
   "line": "s03-l3"
  },
  {
   "start": 37.386,
   "end": 40.903,
   "text": "Coba juga padanan bahasa Inggris.",
   "scene": 3,
   "line": "s03-l3"
  },
  {
   "start": 45,
   "end": 48.721,
   "text": "Artikel terkenal ini membahas musisi profesional.",
   "scene": 4,
   "line": "s04-l1"
  },
  {
   "start": 48.801,
   "end": 50.852,
   "text": "Bisa membantu menjelaskan konsep.",
   "scene": 4,
   "line": "s04-l2"
  },
  {
   "start": 50.932,
   "end": 52.699,
   "text": "Cari juga penelitian siswa pemula",
   "scene": 4,
   "line": "s04-l2"
  },
  {
   "start": 52.779,
   "end": 56.683,
   "text": "agar konteks pembelajaranmu terwakili.",
   "scene": 4,
   "line": "s04-l2"
  },
  {
   "start": 60.183,
   "end": 63.521,
   "text": "Judulnya cocok. Langsung saya kutip?",
   "scene": 5,
   "line": "s05-l1"
  },
  {
   "start": 63.601,
   "end": 65.327,
   "text": "Baca metode dan hasilnya dulu.",
   "scene": 5,
   "line": "s05-l2"
  },
  {
   "start": 65.407,
   "end": 67.516,
   "text": "Apakah temuannya mendukung pernyataanmu?",
   "scene": 5,
   "line": "s05-l2"
  },
  {
   "start": 67.596,
   "end": 71.123,
   "text": "Periksa juga kredibilitas sumbernya.",
   "scene": 5,
   "line": "s05-l2"
  },
  {
   "start": 75.183,
   "end": 77.2,
   "text": "Bacaan ini membahas mendengar teman;",
   "scene": 6,
   "line": "s06-l1"
  },
  {
   "start": 77.28,
   "end": 79.316,
   "text": "yang lain, isyarat gerak.",
   "scene": 6,
   "line": "s06-l1"
  },
  {
   "start": 79.396,
   "end": 81.602,
   "text": "Apa yang ingin kamu telusuri?",
   "scene": 6,
   "line": "s06-l2"
  },
  {
   "start": 81.682,
   "end": 85.69,
   "text": "Bagaimana kelompok kami menggunakan keduanya.",
   "scene": 6,
   "line": "s06-l3"
  },
  {
   "start": 90.183,
   "end": 93.089,
   "text": "«Siswa kurang kompak.» Cukup, Pak?",
   "scene": 7,
   "line": "s07-l1"
  },
  {
   "start": 93.169,
   "end": 95.563,
   "text": "Apa yang terjadi dan dampaknya?",
   "scene": 7,
   "line": "s07-l2"
  },
  {
   "start": 95.643,
   "end": 98.521,
   "text": "Tempo meningkat, beberapa siswa tertinggal,",
   "scene": 7,
   "line": "s07-l3"
  },
  {
   "start": 98.601,
   "end": 101.694,
   "text": "dan latihan berhenti.",
   "scene": 7,
   "line": "s07-l3"
  },
  {
   "start": 105.194,
   "end": 107.138,
   "text": "Apa yang belum jelas?",
   "scene": 8,
   "line": "s08-l1"
  },
  {
   "start": 107.218,
   "end": 109.737,
   "text": "Bagaimana siswa mengikuti tempo teman.",
   "scene": 8,
   "line": "s08-l2"
  },
  {
   "start": 109.817,
   "end": 112.008,
   "text": "Hubungkan dengan bukti awal dan bacaan.",
   "scene": 8,
   "line": "s08-l3"
  },
  {
   "start": 112.088,
   "end": 115.622,
   "text": "Jelaskan mengapa penting dipahami.",
   "scene": 8,
   "line": "s08-l3"
  },
  {
   "start": 120.194,
   "end": 123.613,
   "text": "Bagaimana siswa pemula menggunakan isyarat bunyi dan gerak",
   "scene": 9,
   "line": "s09-l1"
  },
  {
   "start": 123.693,
   "end": 126.723,
   "text": "untuk menjaga tempo dalam ansambel?",
   "scene": 9,
   "line": "s09-l1"
  },
  {
   "start": 126.803,
   "end": 128.067,
   "text": "Oke, ini sudah jelas:",
   "scene": 9,
   "line": "s09-l2"
  },
  {
   "start": 128.147,
   "end": 131.222,
   "text": "siapa, proses apa, dan dalam konteks apa.",
   "scene": 9,
   "line": "s09-l2"
  },
  {
   "start": 131.302,
   "end": 134.815,
   "text": "Sekarang pastikan bisa dijawab dengan data yang tersedia.",
   "scene": 9,
   "line": "s09-l2"
  },
  {
   "start": 134.895,
   "end": 138.856,
   "text": "Oh, jadi harus saya cek dulu datanya.",
   "scene": 9,
   "line": "s09-l3"
  },
  {
   "start": 142.356,
   "end": 146.591,
   "text": "Saya gunakan kuesioner saja? Soalnya lebih cepat dibagikan",
   "scene": 10,
   "line": "s10-l1"
  },
  {
   "start": 146.671,
   "end": 148.399,
   "text": "ke semua siswa.",
   "scene": 10,
   "line": "s10-l1"
  },
  {
   "start": 148.479,
   "end": 151.655,
   "text": "Apakah itu menunjukkan tindakan saat latihan?",
   "scene": 10,
   "line": "s10-l2"
  },
  {
   "start": 151.735,
   "end": 154.591,
   "text": "Oh, jadi kuesioner saja belum cukup, ya?",
   "scene": 10,
   "line": "s10-l3"
  },
  {
   "start": 154.671,
   "end": 159.737,
   "text": "Saya perlu mengamati, lalu menanyakan alasannya.",
   "scene": 10,
   "line": "s10-l3"
  },
  {
   "start": 163.237,
   "end": 165.382,
   "text": "Studi kasus kualitatif dapat sesuai:",
   "scene": 11,
   "line": "s11-l1"
  },
  {
   "start": 165.462,
   "end": 167.044,
   "text": "kita menelaah proses secara mendalam",
   "scene": 11,
   "line": "s11-l1"
  },
  {
   "start": 167.124,
   "end": 170.028,
   "text": "dalam satu kelompok dan konteks latihannya.",
   "scene": 11,
   "line": "s11-l1"
  },
  {
   "start": 170.108,
   "end": 173.571,
   "text": "Saya membandingkan pengamatan dengan wawancara?",
   "scene": 11,
   "line": "s11-l2"
  },
  {
   "start": 173.651,
   "end": 176.516,
   "text": "Ya, untuk menelaah pola penggunaan isyarat.",
   "scene": 11,
   "line": "s11-l3"
  },
  {
   "start": 176.596,
   "end": 178.632,
   "text": "Periksa juga apakah pola ini muncul lagi",
   "scene": 11,
   "line": "s11-l3"
  },
  {
   "start": 178.712,
   "end": 181.434,
   "text": "pada latihan lain.",
   "scene": 11,
   "line": "s11-l3"
  },
  {
   "start": 184.934,
   "end": 186.949,
   "text": "Kalau menguji apakah latihan metronom",
   "scene": 12,
   "line": "s12-l1"
  },
  {
   "start": 187.029,
   "end": 189.604,
   "text": "meningkatkan kestabilan tempo?",
   "scene": 12,
   "line": "s12-l1"
  },
  {
   "start": 189.684,
   "end": 190.7,
   "text": "Pertanyaannya berubah.",
   "scene": 12,
   "line": "s12-l2"
  },
  {
   "start": 190.78,
   "end": 193.24,
   "text": "Perlu ukuran tempo, perbandingan yang sesuai,",
   "scene": 12,
   "line": "s12-l2"
  },
  {
   "start": 193.32,
   "end": 196.618,
   "text": "dan perhatian pada faktor lain.",
   "scene": 12,
   "line": "s12-l2"
  },
  {
   "start": 200.118,
   "end": 202.66,
   "text": "Sekarang saya lihat semuanya nyambung:",
   "scene": 13,
   "line": "s13-l1"
  },
  {
   "start": 202.74,
   "end": 206.068,
   "text": "bacaan, masalah, pertanyaan, dan caranya.",
   "scene": 13,
   "line": "s13-l1"
  },
  {
   "start": 206.148,
   "end": 209.069,
   "text": "Siapkan persetujuan sebelum mengumpulkan data.",
   "scene": 13,
   "line": "s13-l2"
  },
  {
   "start": 209.149,
   "end": 212.788,
   "text": "Dan jelaskan alasan setiap pilihanmu.",
   "scene": 13,
   "line": "s13-l3"
  },
  {
   "start": 216.288,
   "end": 217.795,
   "text": "Mari kita rangkum tujuh langkah",
   "scene": 14,
   "line": "s14-l1"
  },
  {
   "start": 217.875,
   "end": 219.882,
   "text": "perjalanan penelitian Vidka.",
   "scene": 14,
   "line": "s14-l1"
  },
  {
   "start": 219.962,
   "end": 222.553,
   "text": "Semua dimulai dari referensi yang relevan,",
   "scene": 14,
   "line": "s14-l2"
  },
  {
   "start": 222.633,
   "end": 226.377,
   "text": "sampai akhirnya data dan analisis saling terhubung.",
   "scene": 14,
   "line": "s14-l2"
  },
  {
   "start": 226.457,
   "end": 227.941,
   "text": "Sampai jumpa!",
   "scene": 14,
   "line": "s14-l3"
  },
  {
   "start": 228.021,
   "end": 231.054,
   "text": "Semoga bermanfaat!",
   "scene": 14,
   "line": "s14-l4"
  }
 ],
 "note": "Each line is its own recording placed on the timeline; cue times come from clip boundaries (and the clips' internal pauses for multi-cue lines), so they are exact to the recordings."
}