 ],
 "cues": [
  {
   "start": 0,
   "end": 1.494,
   "text": "Vidka: Pak, artikel saya banyak,",
   "scene": 1,
   "line": "s01-l1"
  },
  {
   "start": 1.554,
   "end": 3.29,
   "text": "tetapi saya bingung memilih.",
   "scene": 1,
   "line": "s01-l1"
  },
  {
   "start": 3.94,
   "end": 5.25,
   "text": "Herry: Buka lagi catatanmu.",
   "scene": 1,
   "line": "s01-l2"
  },
  {
   "start": 5.31,
   "end": 6.778,
   "text": "Apa yang ingin kamu pahami?",
   "scene": 1,
   "line": "s01-l2"
  },
  {
   "start": 15,
   "end": 16.107,
   "text": "Ardipal: Apa kata kuncimu?",
   "scene": 2,
   "line": "s02-l1"
  },
  {
   "start": 16.757,
   "end": 17.911,
   "text": "Vidka: «Musik», Prof.",
   "scene": 2,
   "line": "s02-l2"
  },
  {
   "start": 18.561,
   "end": 20.611,
   "text": "Ardipal: Persempit: siswa pemula, ansambel,",
   "scene": 2,
   "line": "s02-l3"
  },
  {
   "start": 20.671,
   "end": 22.024,
   "text": "dan koordinasi tempo.",
   "scene": 2,
   "line": "s02-l3"
  },
  {
   "start": 22.084,
   "end": 24.003,
   "text": "Coba juga padanan bahasa Inggris.",
   "scene": 2,
   "line": "s02-l3"
  },
  {
   "start": 30,
   "end": 31.258,
   "text": "Vidka: Artikel terkenal ini",
   "scene": 3,
   "line": "s03-l1"
  },
  {
   "start": 31.318,
   "end": 33.151,
   "text": "membahas musisi profesional.",
   "scene": 3,
   "line": "s03-l1"
  },
  {
   "start": 33.801,
   "end": 35.871,
   "text": "Herry: Bisa membantu menjelaskan konsep.",
   "scene": 3,
   "line": "s03-l2"
  },
  {
   "start": 35.931,
   "end": 37.719,
   "text": "Cari juga penelitian siswa pemula",
   "scene": 3,
   "line": "s03-l2"
  },
  {
   "start": 37.779,
   "end": 40.083,
   "text": "agar konteks pembelajaranmu terwakili.",
   "scene": 3,
   "line": "s03-l2"
  },
  {
   "start": 45.183,
   "end": 47.651,
   "text": "Vidka: Judulnya cocok. Langsung saya kutip?",
   "scene": 4,
   "line": "s04-l1"
  },
  {
   "start": 48.301,
   "end": 50.046,
   "text": "Ardipal: Baca metode dan hasilnya dulu.",
   "scene": 4,
   "line": "s04-l2"
  },
  {
   "start": 50.106,
   "end": 52.228,
   "text": "Apakah temuannya mendukung pernyataanmu?",
   "scene": 4,
   "line": "s04-l2"
  },
  {
   "start": 52.288,
   "end": 54.223,
   "text": "Periksa juga kredibilitas sumbernya.",
   "scene": 4,
   "line": "s04-l2"
  },
  {
   "start": 60.183,
   "end": 62.093,
   "text": "Vidka: Bacaan ini membahas mendengar teman;",
   "scene": 5,
   "line": "s05-l1"
  },
  {
   "start": 62.153,
   "end": 63.746,
   "text": "yang lain, isyarat gerak.",
   "scene": 5,
   "line": "s05-l1"
  },
  {
   "start": 64.396,
   "end": 65.732,
   "text": "Herry: Apa yang ingin kamu telusuri?",
   "scene": 5,
   "line": "s05-l2"
  },
  {
   "start": 66.382,
   "end": 67.58,
   "text": "Vidka: Bagaimana kelompok kami",
   "scene": 5,
   "line": "s05-l3"
  },
  {
   "start": 67.64,
   "end": 68.79,
   "text": "menggunakan keduanya.",
   "scene": 5,
   "line": "s05-l3"
  },
  {
   "start": 75.183,
   "end": 77.219,
   "text": "Vidka: «Siswa kurang kompak.» Cukup, Pak?",
   "scene": 6,
   "line": "s06-l1"
  },
  {
   "start": 77.869,
   "end": 79.393,
   "text": "Herry: Apa yang terjadi dan dampaknya?",
   "scene": 6,
   "line": "s06-l2"
  },
  {
   "start": 80.043,
   "end": 81.201,
   "text": "Vidka: Tempo meningkat,",
   "scene": 6,
   "line": "s06-l3"
  },
  {
   "start": 81.261,
   "end": 82.941,
   "text": "beberapa siswa tertinggal,",
   "scene": 6,
   "line": "s06-l3"
  },
  {
   "start": 83.001,
   "end": 84.494,
   "text": "dan latihan berhenti.",
   "scene": 6,
   "line": "s06-l3"
  },
  {
   "start": 90.183,
   "end": 91.256,
   "text": "Ardipal: Apa yang belum jelas?",
   "scene": 7,
   "line": "s07-l1"
  },
  {
   "start": 91.906,
   "end": 93.855,
   "text": "Vidka: Bagaimana siswa mengikuti tempo teman.",
   "scene": 7,
   "line": "s07-l2"
  },
  {
   "start": 94.505,
   "end": 96.709,
   "text": "Ardipal: Hubungkan dengan bukti awal dan bacaan.",
   "scene": 7,
   "line": "s07-l3"
  },
  {
   "start": 96.769,
   "end": 98.71,
   "text": "Jelaskan mengapa penting dipahami.",
   "scene": 7,
   "line": "s07-l3"
  },
  {
   "start": 105.183,
   "end": 106.492,
   "text": "Vidka: Bagaimana siswa pemula",
   "scene": 8,
   "line": "s08-l1"
  },
  {
   "start": 106.552,
   "end": 108.622,
   "text": "menggunakan isyarat bunyi dan gerak",
   "scene": 8,
   "line": "s08-l1"
  },
  {
   "start": 108.682,
   "end": 110.842,
   "text": "untuk menjaga tempo dalam ansambel?",
   "scene": 8,
   "line": "s08-l1"
  },
  {
   "start": 111.492,
   "end": 113.17,
   "text": "Herry: Jelas: siapa, proses apa,",
   "scene": 8,
   "line": "s08-l2"
  },
  {
   "start": 113.23,
   "end": 115.234,
   "text": "dan dalam konteks apa.",
   "scene": 8,
   "line": "s08-l2"
  },
  {
   "start": 120.334,
   "end": 121.813,
   "text": "Vidka: Saya gunakan kuesioner saja?",
   "scene": 9,
   "line": "s09-l1"
  },
  {
   "start": 122.463,
   "end": 123.557,
   "text": "Ardipal: Apakah itu menunjukkan",
   "scene": 9,
   "line": "s09-l2"
  },
  {
   "start": 123.617,
   "end": 124.77,
   "text": "tindakan saat latihan?",
   "scene": 9,
   "line": "s09-l2"
  },
  {
   "start": 125.42,
   "end": 126.429,
   "text": "Vidka: Belum cukup.",
   "scene": 9,
   "line": "s09-l3"
  },
  {
   "start": 126.489,
   "end": 127.768,
   "text": "Saya perlu mengamati,",
   "scene": 9,
   "line": "s09-l3"
  },
  {
   "start": 127.828,
   "end": 129.732,
   "text": "lalu menanyakan alasannya.",
   "scene": 9,
   "line": "s09-l3"
  },
  {
   "start": 135.334,
   "end": 136.932,
   "text": "Herry: Studi kasus kualitatif dapat sesuai",
   "scene": 10,
   "line": "s10-l1"
  },
  {
   "start": 136.992,
   "end": 138.324,
   "text": "untuk memahami kelompok ini.",
   "scene": 10,
   "line": "s10-l1"
  },
  {
   "start": 138.974,
   "end": 140.542,
   "text": "Vidka: Saya membandingkan pengamatan",
   "scene": 10,
   "line": "s10-l2"
  },
  {
   "start": 140.602,
   "end": 141.568,
   "text": "dengan wawancara?",
   "scene": 10,
   "line": "s10-l2"
  },
  {
   "start": 142.218,
   "end": 144.391,
   "text": "Herry: Ya, untuk menelaah pola penggunaan isyarat.",
   "scene": 10,
   "line": "s10-l3"
  },
  {
   "start": 150.334,
   "end": 152.37,
   "text": "Vidka: Kalau menguji apakah latihan metronom",
   "scene": 11,
   "line": "s11-l1"
  },
  {
   "start": 152.43,
   "end": 154.135,
   "text": "meningkatkan kestabilan tempo?",
   "scene": 11,
   "line": "s11-l1"
  },
  {
   "start": 154.785,
   "end": 155.818,
   "text": "Ardipal: Pertanyaannya berubah.",
   "scene": 11,
   "line": "s11-l2"
  },
  {
   "start": 155.878,
   "end": 158.361,
   "text": "Perlu ukuran tempo, perbandingan yang sesuai,",
   "scene": 11,
   "line": "s11-l2"
  },
  {
   "start": 158.421,
   "end": 160.119,
   "text": "dan perhatian pada faktor lain.",
   "scene": 11,
   "line": "s11-l2"
  },
  {
   "start": 165.334,
   "end": 167.557,
   "text": "Vidka: Sekarang bacaan, masalah, pertanyaan,",
   "scene": 12,
   "line": "s12-l1"
  },
  {
   "start": 167.617,
   "end": 170.204,
   "text": "dan cara penelitian saya saling terhubung.",
   "scene": 12,
   "line": "s12-l1"
  },
  {
   "start": 170.854,
   "end": 171.791,
   "text": "Herry: Siapkan persetujuan",
   "scene": 12,
   "line": "s12-l2"
  },
  {
   "start": 171.851,
   "end": 173.205,
   "text": "sebelum mengumpulkan data.",
   "scene": 12,
   "line": "s12-l2"
  },
  {
   "start": 173.855,
   "end": 175.894,
   "text": "Ardipal: Dan jelaskan alasan setiap pilihanmu.",
   "scene": 12,
   "line": "s12-l3"
  }
 ],
 "note": "Each line is its own recording placed on the timeline; cue times come from clip boundaries (and the clips' internal pauses for multi-cue lines), so they are exact to the recordings."
}