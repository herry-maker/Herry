 ],
 "cues": [
  {
   "start": 0.4,
   "end": 3.697,
   "text": "Saya mencari bacaan tentang tempo kelompok kami,",
   "scene": 1,
   "line": "s01-l1"
  },
  {
   "start": 3.777,
   "end": 6.443,
   "text": "tetapi malah bingung memilih.",
   "scene": 1,
   "line": "s01-l1"
  },
  {
   "start": 6.523,
   "end": 10.961,
   "text": "Buka lagi catatanmu. Apa yang ingin kamu pahami?",
   "scene": 1,
   "line": "s01-l2"
  },
  {
   "start": 15,
   "end": 16.977,
   "text": "Apa kata kuncimu?",
   "scene": 2,
   "line": "s02-l1"
  },
  {
   "start": 17.057,
   "end": 18.781,
   "text": "«Musik», Prof.",
   "scene": 2,
   "line": "s02-l2"
  },
  {
   "start": 18.861,
   "end": 22.306,
   "text": "Persempit: siswa pemula, ansambel, dan koordinasi tempo.",
   "scene": 2,
   "line": "s02-l3"
  },
  {
   "start": 22.386,
   "end": 25.903,
   "text": "Coba juga padanan bahasa Inggris.",
   "scene": 2,
   "line": "s02-l3"
  },
  {
   "start": 30,
   "end": 33.721,
   "text": "Artikel terkenal ini membahas musisi profesional.",
   "scene": 3,
   "line": "s03-l1"
  },
  {
   "start": 33.801,
   "end": 35.852,
   "text": "Bisa membantu menjelaskan konsep.",
   "scene": 3,
   "line": "s03-l2"
  },
  {
   "start": 35.932,
   "end": 37.699,
   "text": "Cari juga penelitian siswa pemula",
   "scene": 3,
   "line": "s03-l2"
  },
  {
   "start": 37.779,
   "end": 41.683,
   "text": "agar konteks pembelajaranmu terwakili.",
   "scene": 3,
   "line": "s03-l2"
  },
  {
   "start": 45.183,
   "end": 48.521,
   "text": "Judulnya cocok. Langsung saya kutip?",
   "scene": 4,
   "line": "s04-l1"
  },
  {
   "start": 48.601,
   "end": 50.327,
   "text": "Baca metode dan hasilnya dulu.",
   "scene": 4,
   "line": "s04-l2"
  },
  {
   "start": 50.407,
   "end": 52.516,
   "text": "Apakah temuannya mendukung pernyataanmu?",
   "scene": 4,
   "line": "s04-l2"
  },
  {
   "start": 52.596,
   "end": 56.123,
   "text": "Periksa juga kredibilitas sumbernya.",
   "scene": 4,
   "line": "s04-l2"
  },
  {
   "start": 60.183,
   "end": 62.2,
   "text": "Bacaan ini membahas mendengar teman;",
   "scene": 5,
   "line": "s05-l1"
  },
  {
   "start": 62.28,
   "end": 64.316,
   "text": "yang lain, isyarat gerak.",
   "scene": 5,
   "line": "s05-l1"
  },
  {
   "start": 64.396,
   "end": 66.602,
   "text": "Apa yang ingin kamu telusuri?",
   "scene": 5,
   "line": "s05-l2"
  },
  {
   "start": 66.682,
   "end": 70.69,
   "text": "Bagaimana kelompok kami menggunakan keduanya.",
   "scene": 5,
   "line": "s05-l3"
  },
  {
   "start": 75.183,
   "end": 78.089,
   "text": "«Siswa kurang kompak.» Cukup, Pak?",
   "scene": 6,
   "line": "s06-l1"
  },
  {
   "start": 78.169,
   "end": 80.563,
   "text": "Apa yang terjadi dan dampaknya?",
   "scene": 6,
   "line": "s06-l2"
  },
  {
   "start": 80.643,
   "end": 83.521,
   "text": "Tempo meningkat, beberapa siswa tertinggal,",
   "scene": 6,
   "line": "s06-l3"
  },
  {
   "start": 83.601,
   "end": 86.694,
   "text": "dan latihan berhenti.",
   "scene": 6,
   "line": "s06-l3"
  },
  {
   "start": 90.194,
   "end": 92.138,
   "text": "Apa yang belum jelas?",
   "scene": 7,
   "line": "s07-l1"
  },
  {
   "start": 92.218,
   "end": 94.737,
   "text": "Bagaimana siswa mengikuti tempo teman.",
   "scene": 7,
   "line": "s07-l2"
  },
  {
   "start": 94.817,
   "end": 97.008,
   "text": "Hubungkan dengan bukti awal dan bacaan.",
   "scene": 7,
   "line": "s07-l3"
  },
  {
   "start": 97.088,
   "end": 100.622,
   "text": "Jelaskan mengapa penting dipahami.",
   "scene": 7,
   "line": "s07-l3"
  },
  {
   "start": 105.194,
   "end": 108.613,
   "text": "Bagaimana siswa pemula menggunakan isyarat bunyi dan gerak",
   "scene": 8,
   "line": "s08-l1"
  },
  {
   "start": 108.693,
   "end": 111.723,
   "text": "untuk menjaga tempo dalam ansambel?",
   "scene": 8,
   "line": "s08-l1"
  },
  {
   "start": 111.803,
   "end": 114.815,
   "text": "Jelas: siapa, proses apa, dan dalam konteks apa.",
   "scene": 8,
   "line": "s08-l2"
  },
  {
   "start": 114.895,
   "end": 120.238,
   "text": "Sekarang pastikan dapat dijawab dengan data yang tersedia.",
   "scene": 8,
   "line": "s08-l2"
  },
  {
   "start": 123.738,
   "end": 126.087,
   "text": "Saya gunakan kuesioner saja?",
   "scene": 9,
   "line": "s09-l1"
  },
  {
   "start": 126.167,
   "end": 129.344,
   "text": "Apakah itu menunjukkan tindakan saat latihan?",
   "scene": 9,
   "line": "s09-l2"
  },
  {
   "start": 129.424,
   "end": 131.752,
   "text": "Belum cukup. Saya perlu mengamati,",
   "scene": 9,
   "line": "s09-l3"
  },
  {
   "start": 131.832,
   "end": 135.336,
   "text": "lalu menanyakan alasannya.",
   "scene": 9,
   "line": "s09-l3"
  },
  {
   "start": 138.836,
   "end": 140.981,
   "text": "Studi kasus kualitatif dapat sesuai:",
   "scene": 10,
   "line": "s10-l1"
  },
  {
   "start": 141.061,
   "end": 142.643,
   "text": "kita menelaah proses secara mendalam",
   "scene": 10,
   "line": "s10-l1"
  },
  {
   "start": 142.723,
   "end": 145.626,
   "text": "dalam satu kelompok dan konteks latihannya.",
   "scene": 10,
   "line": "s10-l1"
  },
  {
   "start": 145.706,
   "end": 149.17,
   "text": "Saya membandingkan pengamatan dengan wawancara?",
   "scene": 10,
   "line": "s10-l2"
  },
  {
   "start": 149.25,
   "end": 152.114,
   "text": "Ya, untuk menelaah pola penggunaan isyarat.",
   "scene": 10,
   "line": "s10-l3"
  },
  {
   "start": 152.194,
   "end": 154.231,
   "text": "Periksa juga apakah pola ini muncul lagi",
   "scene": 10,
   "line": "s10-l3"
  },
  {
   "start": 154.311,
   "end": 157.032,
   "text": "pada latihan lain.",
   "scene": 10,
   "line": "s10-l3"
  },
  {
   "start": 160.532,
   "end": 162.548,
   "text": "Kalau menguji apakah latihan metronom",
   "scene": 11,
   "line": "s11-l1"
  },
  {
   "start": 162.628,
   "end": 165.203,
   "text": "meningkatkan kestabilan tempo?",
   "scene": 11,
   "line": "s11-l1"
  },
  {
   "start": 165.283,
   "end": 166.299,
   "text": "Pertanyaannya berubah.",
   "scene": 11,
   "line": "s11-l2"
  },
  {
   "start": 166.379,
   "end": 168.839,
   "text": "Perlu ukuran tempo, perbandingan yang sesuai,",
   "scene": 11,
   "line": "s11-l2"
  },
  {
   "start": 168.919,
   "end": 172.217,
   "text": "dan perhatian pada faktor lain.",
   "scene": 11,
   "line": "s11-l2"
  },
  {
   "start": 175.717,
   "end": 177.919,
   "text": "Sekarang bacaan, masalah, pertanyaan,",
   "scene": 12,
   "line": "s12-l1"
  },
  {
   "start": 177.999,
   "end": 181.156,
   "text": "dan cara penelitian saya saling terhubung.",
   "scene": 12,
   "line": "s12-l1"
  },
  {
   "start": 181.236,
   "end": 184.157,
   "text": "Siapkan persetujuan sebelum mengumpulkan data.",
   "scene": 12,
   "line": "s12-l2"
  },
  {
   "start": 184.237,
   "end": 187.876,
   "text": "Dan jelaskan alasan setiap pilihanmu.",
   "scene": 12,
   "line": "s12-l3"
  }
 ],
 "note": "Each line is its own recording placed on the timeline; cue times come from clip boundaries (and the clips' internal pauses for multi-cue lines), so they are exact to the recordings."
}