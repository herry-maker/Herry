 "cues": [
  {
   "start": 0.4,
   "end": 4.26,
   "text": "Pak, artikel saya banyak, tetapi saya bingung memilih.",
   "scene": 1,
   "line": "s01-l1"
  },
  {
   "start": 4.34,
   "end": 8.778,
   "text": "Buka lagi catatanmu. Apa yang ingin kamu pahami?",
   "scene": 1,
   "line": "s01-l2"
  },
  {
   "start": 15,
   "end": 16.977,
   "text": "Apa kata kuncimu?",
   "scene": 2,
   "line": "s02-l1"
  },
  {
   "start": 17.057,
   "end": 18.781,
   "text": "«Musik», Prof.",
   "scene": 2,
   "line": "s02-l2"
  },
  {
   "start": 18.861,
   "end": 22.306,
   "text": "Persempit: siswa pemula, ansambel, dan koordinasi tempo.",
   "scene": 2,
   "line": "s02-l3"
  },
  {
   "start": 22.386,
   "end": 25.903,
   "text": "Coba juga padanan bahasa Inggris.",
   "scene": 2,
   "line": "s02-l3"
  },
  {
   "start": 30,
   "end": 33.721,
   "text": "Artikel terkenal ini membahas musisi profesional.",
   "scene": 3,
   "line": "s03-l1"
  },
  {
   "start": 33.801,
   "end": 35.852,
   "text": "Bisa membantu menjelaskan konsep.",
   "scene": 3,
   "line": "s03-l2"
  },
  {
   "start": 35.932,
   "end": 37.699,
   "text": "Cari juga penelitian siswa pemula",
   "scene": 3,
   "line": "s03-l2"
  },
  {
   "start": 37.779,
   "end": 41.683,
   "text": "agar konteks pembelajaranmu terwakili.",
   "scene": 3,
   "line": "s03-l2"
  },
  {
   "start": 45.183,
   "end": 48.521,
   "text": "Judulnya cocok. Langsung saya kutip?",
   "scene": 4,
   "line": "s04-l1"
  },
  {
   "start": 48.601,
   "end": 50.327,
   "text": "Baca metode dan hasilnya dulu.",
   "scene": 4,
   "line": "s04-l2"
  },
  {
   "start": 50.407,
   "end": 52.516,
   "text": "Apakah temuannya mendukung pernyataanmu?",
   "scene": 4,
   "line": "s04-l2"
  },
  {
   "start": 52.596,
   "end": 56.123,
   "text": "Periksa juga kredibilitas sumbernya.",
   "scene": 4,
   "line": "s04-l2"
  },
  {
   "start": 60.183,
   "end": 62.2,
   "text": "Bacaan ini membahas mendengar teman;",
   "scene": 5,
   "line": "s05-l1"
  },
  {
   "start": 62.28,
   "end": 64.316,
   "text": "yang lain, isyarat gerak.",
   "scene": 5,
   "line": "s05-l1"
  },
  {
   "start": 64.396,
   "end": 66.602,
   "text": "Apa yang ingin kamu telusuri?",
   "scene": 5,
   "line": "s05-l2"
  },
  {
   "start": 66.682,
   "end": 70.69,
   "text": "Bagaimana kelompok kami menggunakan keduanya.",
   "scene": 5,
   "line": "s05-l3"
  },
  {
   "start": 75.183,
   "end": 78.089,
   "text": "«Siswa kurang kompak.» Cukup, Pak?",
   "scene": 6,
   "line": "s06-l1"
  },
  {
   "start": 78.169,
   "end": 80.563,
   "text": "Apa yang terjadi dan dampaknya?",
   "scene": 6,
   "line": "s06-l2"
  },
  {
   "start": 80.643,
   "end": 83.521,
   "text": "Tempo meningkat, beberapa siswa tertinggal,",
   "scene": 6,
   "line": "s06-l3"
  },
  {
   "start": 83.601,
   "end": 86.694,
   "text": "dan latihan berhenti.",
   "scene": 6,
   "line": "s06-l3"
  },
  {
   "start": 90.194,
   "end": 92.138,
   "text": "Apa yang belum jelas?",
   "scene": 7,
   "line": "s07-l1"
  },
  {
   "start": 92.218,
   "end": 94.737,
   "text": "Bagaimana siswa mengikuti tempo teman.",
   "scene": 7,
   "line": "s07-l2"
  },
  {
   "start": 94.817,
   "end": 97.008,
   "text": "Hubungkan dengan bukti awal dan bacaan.",
   "scene": 7,
   "line": "s07-l3"
  },
  {
   "start": 97.088,
   "end": 100.622,
   "text": "Jelaskan mengapa penting dipahami.",
   "scene": 7,
   "line": "s07-l3"
  },
  {
   "start": 105.194,
   "end": 108.613,
   "text": "Bagaimana siswa pemula menggunakan isyarat bunyi dan gerak",
   "scene": 8,
   "line": "s08-l1"
  },
  {
   "start": 108.693,
   "end": 111.723,
   "text": "untuk menjaga tempo dalam ansambel?",
   "scene": 8,
   "line": "s08-l1"
  },
  {
   "start": 111.803,
   "end": 117.146,
   "text": "Jelas: siapa, proses apa, dan dalam konteks apa.",
   "scene": 8,
   "line": "s08-l2"
  },
  {
   "start": 120.646,
   "end": 122.995,
   "text": "Saya gunakan kuesioner saja?",
   "scene": 9,
   "line": "s09-l1"
  },
  {
   "start": 123.075,
   "end": 126.251,
   "text": "Apakah itu menunjukkan tindakan saat latihan?",
   "scene": 9,
   "line": "s09-l2"
  },
  {
   "start": 126.331,
   "end": 128.659,
   "text": "Belum cukup. Saya perlu mengamati,",
   "scene": 9,
   "line": "s09-l3"
  },
  {
   "start": 128.739,
   "end": 132.243,
   "text": "lalu menanyakan alasannya.",
   "scene": 9,
   "line": "s09-l3"
  },
  {
   "start": 135.743,
   "end": 137.321,
   "text": "Studi kasus kualitatif dapat sesuai",
   "scene": 10,
   "line": "s10-l1"
  },
  {
   "start": 137.401,
   "end": 139.303,
   "text": "untuk memahami kelompok ini.",
   "scene": 10,
   "line": "s10-l1"
  },
  {
   "start": 139.383,
   "end": 142.846,
   "text": "Saya membandingkan pengamatan dengan wawancara?",
   "scene": 10,
   "line": "s10-l2"
  },
  {
   "start": 142.926,
   "end": 146.699,
   "text": "Ya, untuk menelaah pola penggunaan isyarat.",
   "scene": 10,
   "line": "s10-l3"
  },
  {
   "start": 150.743,
   "end": 152.759,
   "text": "Kalau menguji apakah latihan metronom",
   "scene": 11,
   "line": "s11-l1"
  },
  {
   "start": 152.839,
   "end": 155.414,
   "text": "meningkatkan kestabilan tempo?",
   "scene": 11,
   "line": "s11-l1"
  },
  {
   "start": 155.494,
   "end": 156.51,
   "text": "Pertanyaannya berubah.",
   "scene": 11,
   "line": "s11-l2"
  },
  {
   "start": 156.59,
   "end": 159.049,
   "text": "Perlu ukuran tempo, perbandingan yang sesuai,",
   "scene": 11,
   "line": "s11-l2"
  },
  {
   "start": 159.129,
   "end": 162.427,
   "text": "dan perhatian pada faktor lain.",
   "scene": 11,
   "line": "s11-l2"
  },
  {
   "start": 165.927,
   "end": 168.13,
   "text": "Sekarang bacaan, masalah, pertanyaan,",
   "scene": 12,
   "line": "s12-l1"
  },
  {
   "start": 168.21,
   "end": 171.367,
   "text": "dan cara penelitian saya saling terhubung.",
   "scene": 12,
   "line": "s12-l1"
  },
  {
   "start": 171.447,
   "end": 174.368,
   "text": "Siapkan persetujuan sebelum mengumpulkan data.",
   "scene": 12,
   "line": "s12-l2"
  },
  {
   "start": 174.448,
   "end": 178.087,
   "text": "Dan jelaskan alasan setiap pilihanmu.",
   "scene": 12,
   "line": "s12-l3"
  }
 ],
 "note": "Each line is its own recording placed on the timeline; cue times come from clip boundaries (and the clips' internal pauses for multi-cue lines), so they are exact to the recordings."
