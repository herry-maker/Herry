[
 {
  "scene": 1,
  "text": "Vidka membuka artikel ketiga pagi ini."
 },
 {
  "scene": 1,
  "text": "Semua tentang musik, tak satu pun terasa tepat."
 },
 {
  "scene": 1,
  "text": "Vidka: Pak, referensinya banyak sekali."
 },
 {
  "scene": 1,
  "text": "Mana yang harus saya pakai?"
 },
 {
  "scene": 1,
  "text": "Herry: Mulai dari masalahmu, bukan tumpukannya."
 },
 {
  "scene": 2,
  "text": "Kata kunci «musik» terlalu luas."
 },
 {
  "scene": 2,
  "text": "Herry: Apa yang sebenarnya kamu amati?"
 },
 {
  "scene": 2,
  "text": "Vidka menghapus «musik» dan mengetik ulang:"
 },
 {
  "scene": 2,
  "text": "kekompakan tempo, ansambel, siswa SMP."
 },
 {
  "scene": 2,
  "text": "Tugasmu: tulis tiga kata kunci khusus."
 },
 {
  "scene": 3,
  "text": "Dua artikel lolos saringan."
 },
 {
  "scene": 3,
  "text": "Vidka membandingkan bagian pesertanya."
 },
 {
  "scene": 3,
  "text": "Herry: Yang pertama memberi konsep."
 },
 {
  "scene": 3,
  "text": "Yang kedua memberi konteks siswamu."
 },
 {
  "scene": 3,
  "text": "Keduanya dipakai, untuk tujuan yang berbeda."
 },
 {
  "scene": 4,
  "text": "Membaca artikel bukan mencatat semuanya."
 },
 {
  "scene": 4,
  "text": "Vidka menelusuri bagian metode,"
 },
 {
  "scene": 4,
  "text": "lalu bagian hasil."
 },
 {
  "scene": 4,
  "text": "Satu temuan ditandai, lalu satu pertanyaan:"
 },
 {
  "scene": 4,
  "text": "temuan ini mendukung pernyataan apa?"
 },
 {
  "scene": 5,
  "text": "Dua catatan bacaan, satu pertanyaan penelitian."
 },
 {
  "scene": 5,
  "text": "Vidka mendekatkan keduanya,"
 },
 {
  "scene": 5,
  "text": "menarik garis penghubung,"
 },
 {
  "scene": 5,
  "text": "lalu memperbaiki kalimat pertanyaannya."
 },
 {
  "scene": 5,
  "text": "Vidka: Jadi masalah saya bukan «musik», tapi tempo."
 },
 {
  "scene": 6,
  "text": "«Siswa kurang kompak» masih terlalu umum."
 },
 {
  "scene": 6,
  "text": "Apa yang sebenarnya terjadi?"
 },
 {
  "scene": 6,
  "text": "Vidka: Saat tempo naik, dua siswa tertinggal,"
 },
 {
  "scene": 6,
  "text": "dan latihan berhenti."
 },
 {
  "scene": 6,
  "text": "Kejadian dan dampaknya kini terlihat jelas."
 },
 {
  "scene": 7,
  "text": "Pernyataan masalah disusun dari tiga unsur."
 },
 {
  "scene": 7,
  "text": "Pertama, kejadian yang diamati."
 },
 {
  "scene": 7,
  "text": "Kedua, dampaknya pada latihan."
 },
 {
  "scene": 7,
  "text": "Ketiga, hal yang belum dipahami."
 },
 {
  "scene": 7,
  "text": "Tiga kalimat ini menjadi dasar pertanyaan."
 },
 {
  "scene": 8,
  "text": "Vidka menulis satu pertanyaan yang lengkap."
 },
 {
  "scene": 8,
  "text": "Pertanyaan ini menyebut pesertanya,"
 },
 {
  "scene": 8,
  "text": "proses yang ingin dipahami,"
 },
 {
  "scene": 8,
  "text": "dan konteks tempat proses itu terjadi."
 },
 {
  "scene": 8,
  "text": "Satu kalimat, tiga unsur yang jelas."
 },
 {
  "scene": 9,
  "text": "Data apa yang menjawab pertanyaan itu?"
 },
 {
  "scene": 9,
  "text": "Vidka: Apakah kuesioner saja cukup"
 },
 {
  "scene": 9,
  "text": "menunjukkan apa yang terjadi saat latihan?"
 },
 {
  "scene": 9,
  "text": "Pikirkan: data mana yang menjawab pertanyaanmu?"
 },
 {
  "scene": 9,
  "text": "Vidka: Pengamatan dulu, kuesioner menyusul."
 },
 {
  "scene": 10,
  "text": "Tempo naik; seorang pemain menoleh ke temannya."
 },
 {
  "scene": 10,
  "text": "Vidka mencatat waktunya: menit kedua belas."
 },
 {
  "scene": 10,
  "text": "Pemain: Saya menoleh karena kehilangan hitungan."
 },
 {
  "scene": 10,
  "text": "Keduanya dibandingkan. Itulah analisisnya."
 },
 {
  "scene": 11,
  "text": "Pertanyaan berbeda menuntut rancangan berbeda."
 },
 {
  "scene": 11,
  "text": "Ardipal: Pertanyaan kedua menguji pengaruh."
 },
 {
  "scene": 11,
  "text": "Kamu perlu kelompok pembanding,"
 },
 {
  "scene": 11,
  "text": "dan ukuran tempo sebelum serta sesudah latihan."
 },
 {
  "scene": 11,
  "text": "Bukan «membuktikan», melainkan menguji perbedaan."
 },
 {
  "scene": 12,
  "text": "Dalam satu sesi, Vidka memiliki tiga hal:"
 },
 {
  "scene": 12,
  "text": "masalah yang jelas,"
 },
 {
  "scene": 12,
  "text": "pertanyaan yang lengkap,"
 },
 {
  "scene": 12,
  "text": "dan alasan memilih datanya."
 },
 {
  "scene": 12,
  "text": "Rancangan penelitiannya siap."
 },
 {
  "scene": 12,
  "text": "Tugas: pilih data untuk pertanyaanmu."
 },
 {
  "scene": 12,
  "text": "Jelaskan alasannya."
 }
]