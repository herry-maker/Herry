 "captions": [
  {
   "start": 0,
   "end": 1.91,
   "text": "Vidka: Bacaan ini membahas mendengar teman;"
  },
  {
   "start": 1.97,
   "end": 3.563,
   "text": "yang lain, isyarat gerak."
  },
  {
   "start": 4.213,
   "end": 5.549,
   "text": "Herry: Apa yang ingin kamu telusuri?"
  },
  {
   "start": 6.199,
   "end": 7.397,
   "text": "Vidka: Bagaimana kelompok kami"
  },
  {
   "start": 7.457,
   "end": 8.607,
   "text": "menggunakan keduanya."
  },
  {
   "start": 15,
   "end": 17.036,
   "text": "Vidka: «Siswa kurang kompak.» Cukup, Pak?"
  },
  {
   "start": 17.686,
   "end": 19.21,
   "text": "Herry: Apa yang terjadi dan dampaknya?"
  },
  {
   "start": 19.86,
   "end": 21.018,
   "text": "Vidka: Tempo meningkat,"
  },
  {
   "start": 21.078,
   "end": 22.758,
   "text": "beberapa siswa tertinggal,"
  },
  {
   "start": 22.818,
   "end": 24.311,
   "text": "dan latihan berhenti."
  },
  {
   "start": 30,
   "end": 31.073,
   "text": "Ardipal: Apa yang belum jelas?"
  },
  {
   "start": 31.723,
   "end": 33.672,
   "text": "Vidka: Bagaimana siswa mengikuti tempo teman."
  },
  {
   "start": 34.322,
   "end": 36.526,
   "text": "Ardipal: Hubungkan dengan bukti awal dan bacaan."
  },
  {
   "start": 36.586,
   "end": 38.527,
   "text": "Jelaskan mengapa penting dipahami."
  },
  {
   "start": 45,
   "end": 46.309,
   "text": "Vidka: Bagaimana siswa pemula"
  },
  {
   "start": 46.369,
   "end": 48.439,
   "text": "menggunakan isyarat bunyi dan gerak"
  },
  {
   "start": 48.499,
   "end": 50.659,
   "text": "untuk menjaga tempo dalam ansambel?"
  },
  {
   "start": 51.309,
   "end": 52.987,
   "text": "Herry: Jelas: siapa, proses apa,"
  },
  {
   "start": 53.047,
   "end": 55.051,
   "text": "dan dalam konteks apa."
  }
 ],
