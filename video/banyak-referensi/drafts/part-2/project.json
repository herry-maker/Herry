 "captions": [
  {
   "start": 0.3,
   "end": 3,
   "text": "Dua catatan bacaan, satu pertanyaan penelitian."
  },
  {
   "start": 3.2,
   "end": 5.4,
   "text": "Vidka mendekatkan keduanya,"
  },
  {
   "start": 5.6,
   "end": 8.2,
   "text": "menarik garis penghubung,"
  },
  {
   "start": 8.4,
   "end": 10.8,
   "text": "lalu memperbaiki kalimat pertanyaannya."
  },
  {
   "start": 11,
   "end": 14.6,
   "text": "Vidka: Jadi masalah saya bukan «musik», tapi tempo."
  },
  {
   "start": 15.3,
   "end": 18.2,
   "text": "«Siswa kurang kompak» masih terlalu umum."
  },
  {
   "start": 18.4,
   "end": 20.6,
   "text": "Apa yang sebenarnya terjadi?"
  },
  {
   "start": 20.8,
   "end": 23.8,
   "text": "Vidka: Saat tempo naik, dua siswa tertinggal,"
  },
  {
   "start": 24,
   "end": 25.8,
   "text": "dan latihan berhenti."
  },
  {
   "start": 26.2,
   "end": 29.6,
   "text": "Kejadian dan dampaknya kini terlihat jelas."
  },
  {
   "start": 30.3,
   "end": 33,
   "text": "Pernyataan masalah disusun dari tiga unsur."
  },
  {
   "start": 33.2,
   "end": 35.6,
   "text": "Pertama, kejadian yang diamati."
  },
  {
   "start": 35.8,
   "end": 38,
   "text": "Kedua, dampaknya pada latihan."
  },
  {
   "start": 38.2,
   "end": 40.8,
   "text": "Ketiga, hal yang belum dipahami."
  },
  {
   "start": 41.4,
   "end": 44.4,
   "text": "Tiga kalimat ini menjadi dasar pertanyaan."
  },
  {
   "start": 45.3,
   "end": 48.2,
   "text": "Vidka menulis satu pertanyaan yang lengkap."
  },
  {
   "start": 48.6,
   "end": 50.8,
   "text": "Pertanyaan ini menyebut pesertanya,"
  },
  {
   "start": 51.4,
   "end": 53.8,
   "text": "proses yang ingin dipahami,"
  },
  {
   "start": 54.4,
   "end": 56.6,
   "text": "dan konteks tempat proses itu terjadi."
  },
  {
   "start": 57.2,
   "end": 59.6,
   "text": "Satu kalimat, tiga unsur yang jelas."
  }
 ],
