 "captions": [
  {
   "start": 0,
   "end": 1.494,
   "text": "Vidka: Pak, artikel saya banyak,"
  },
  {
   "start": 1.554,
   "end": 3.29,
   "text": "tetapi saya bingung memilih."
  },
  {
   "start": 3.94,
   "end": 5.25,
   "text": "Herry: Buka lagi catatanmu."
  },
  {
   "start": 5.31,
   "end": 6.778,
   "text": "Apa yang ingin kamu pahami?"
  },
  {
   "start": 15,
   "end": 16.107,
   "text": "Ardipal: Apa kata kuncimu?"
  },
  {
   "start": 16.757,
   "end": 17.911,
   "text": "Vidka: «Musik», Prof."
  },
  {
   "start": 18.561,
   "end": 20.611,
   "text": "Ardipal: Persempit: siswa pemula, ansambel,"
  },
  {
   "start": 20.671,
   "end": 22.024,
   "text": "dan koordinasi tempo."
  },
  {
   "start": 22.084,
   "end": 24.003,
   "text": "Coba juga padanan bahasa Inggris."
  },
  {
   "start": 30,
   "end": 31.258,
   "text": "Vidka: Artikel terkenal ini"
  },
  {
   "start": 31.318,
   "end": 33.151,
   "text": "membahas musisi profesional."
  },
  {
   "start": 33.801,
   "end": 35.871,
   "text": "Herry: Bisa membantu menjelaskan konsep."
  },
  {
   "start": 35.931,
   "end": 37.719,
   "text": "Cari juga penelitian siswa pemula"
  },
  {
   "start": 37.779,
   "end": 40.083,
   "text": "agar konteks pembelajaranmu terwakili."
  },
  {
   "start": 45.183,
   "end": 47.651,
   "text": "Vidka: Judulnya cocok. Langsung saya kutip?"
  },
  {
   "start": 48.301,
   "end": 50.046,
   "text": "Ardipal: Baca metode dan hasilnya dulu."
  },
  {
   "start": 50.106,
   "end": 52.228,
   "text": "Apakah temuannya mendukung pernyataanmu?"
  },
  {
   "start": 52.288,
   "end": 54.223,
   "text": "Periksa juga kredibilitas sumbernya."
  }
 ],
