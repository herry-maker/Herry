 "captions": [
  {
   "start": 0.04,
   "end": 2.04,
   "text": "Vidka membuka artikel ketiga pagi ini."
  },
  {
   "start": 2.72,
   "end": 4.82,
   "text": "Semua tentang musik, tak satu pun terasa tepat."
  },
  {
   "start": 5.36,
   "end": 7.415,
   "text": "Vidka: Pak, referensinya banyak sekali."
  },
  {
   "start": 7.475,
   "end": 9.26,
   "text": "Mana yang harus saya pakai?"
  },
  {
   "start": 10.24,
   "end": 12.24,
   "text": "Herry: Mulai dari masalahmu, bukan tumpukannya."
  },
  {
   "start": 13.76,
   "end": 15.4,
   "text": "Kata kunci «musik» terlalu luas."
  },
  {
   "start": 16.48,
   "end": 18.06,
   "text": "Herry: Apa yang sebenarnya kamu amati?"
  },
  {
   "start": 19.44,
   "end": 21.74,
   "text": "Vidka menghapus «musik» dan mengetik ulang:"
  },
  {
   "start": 22.74,
   "end": 25.24,
   "text": "kekompakan tempo, ansambel, siswa SMP."
  },
  {
   "start": 26.22,
   "end": 28.62,
   "text": "Tugasmu: tulis tiga kata kunci khusus."
  },
  {
   "start": 29.46,
   "end": 30.82,
   "text": "Dua artikel lolos saringan."
  },
  {
   "start": 31.76,
   "end": 33.64,
   "text": "Vidka membandingkan bagian pesertanya."
  },
  {
   "start": 34.46,
   "end": 35.68,
   "text": "Herry: Yang pertama memberi konsep."
  },
  {
   "start": 36.32,
   "end": 38.04,
   "text": "Yang kedua memberi konteks siswamu."
  },
  {
   "start": 38.72,
   "end": 41.64,
   "text": "Keduanya dipakai, untuk tujuan yang berbeda."
  },
  {
   "start": 42.76,
   "end": 44.68,
   "text": "Membaca artikel bukan mencatat semuanya."
  },
  {
   "start": 45.5,
   "end": 47.18,
   "text": "Vidka menelusuri bagian metode,"
  },
  {
   "start": 47.98,
   "end": 48.92,
   "text": "lalu bagian hasil."
  },
  {
   "start": 49.94,
   "end": 52.86,
   "text": "Satu temuan ditandai, lalu satu pertanyaan:"
  },
  {
   "start": 53.68,
   "end": 55.48,
   "text": "temuan ini mendukung pernyataan apa?"
  }
 ],
