 "captions": [
  {
   "start": 0,
   "end": 1.479,
   "text": "Vidka: Saya gunakan kuesioner saja?"
  },
  {
   "start": 2.129,
   "end": 3.223,
   "text": "Ardipal: Apakah itu menunjukkan"
  },
  {
   "start": 3.283,
   "end": 4.436,
   "text": "tindakan saat latihan?"
  },
  {
   "start": 5.086,
   "end": 6.095,
   "text": "Vidka: Belum cukup."
  },
  {
   "start": 6.155,
   "end": 7.434,
   "text": "Saya perlu mengamati,"
  },
  {
   "start": 7.494,
   "end": 9.398,
   "text": "lalu menanyakan alasannya."
  },
  {
   "start": 15,
   "end": 16.598,
   "text": "Herry: Studi kasus kualitatif dapat sesuai"
  },
  {
   "start": 16.658,
   "end": 17.99,
   "text": "untuk memahami kelompok ini."
  },
  {
   "start": 18.64,
   "end": 20.208,
   "text": "Vidka: Saya membandingkan pengamatan"
  },
  {
   "start": 20.268,
   "end": 21.234,
   "text": "dengan wawancara?"
  },
  {
   "start": 21.884,
   "end": 24.057,
   "text": "Herry: Ya, untuk menelaah pola penggunaan isyarat."
  },
  {
   "start": 30,
   "end": 32.036,
   "text": "Vidka: Kalau menguji apakah latihan metronom"
  },
  {
   "start": 32.096,
   "end": 33.801,
   "text": "meningkatkan kestabilan tempo?"
  },
  {
   "start": 34.451,
   "end": 35.484,
   "text": "Ardipal: Pertanyaannya berubah."
  },
  {
   "start": 35.544,
   "end": 38.027,
   "text": "Perlu ukuran tempo, perbandingan yang sesuai,"
  },
  {
   "start": 38.087,
   "end": 39.785,
   "text": "dan perhatian pada faktor lain."
  },
  {
   "start": 45,
   "end": 47.223,
   "text": "Vidka: Sekarang bacaan, masalah, pertanyaan,"
  },
  {
   "start": 47.283,
   "end": 49.87,
   "text": "dan cara penelitian saya saling terhubung."
  },
  {
   "start": 50.52,
   "end": 51.457,
   "text": "Herry: Siapkan persetujuan"
  },
  {
   "start": 51.517,
   "end": 52.871,
   "text": "sebelum mengumpulkan data."
  },
  {
   "start": 53.521,
   "end": 55.56,
   "text": "Ardipal: Dan jelaskan alasan setiap pilihanmu."
  }
 ],
