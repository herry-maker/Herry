 "captions": [
  {
   "start": 0.25,
   "end": 2.219,
   "text": "Data apa yang menjawab pertanyaan itu?"
  },
  {
   "start": 3.092,
   "end": 4.738,
   "text": "Vidka: Apakah kuesioner saja cukup"
  },
  {
   "start": 6.056,
   "end": 8.985,
   "text": "menunjukkan apa yang terjadi saat latihan?"
  },
  {
   "start": 9.878,
   "end": 10.286,
   "text": "Pikirkan: data mana yang menjawab pertanyaanmu?"
  },
  {
   "start": 11.022,
   "end": 12.556,
   "text": "Vidka: Pengamatan dulu, kuesioner menyusul."
  },
  {
   "start": 13.216,
   "end": 16.051,
   "text": "Tempo naik; seorang pemain menoleh ke temannya."
  },
  {
   "start": 17.066,
   "end": 21.084,
   "text": "Vidka mencatat waktunya: menit kedua belas."
  },
  {
   "start": 21.736,
   "end": 25.217,
   "text": "Pemain: Saya menoleh karena kehilangan hitungan."
  },
  {
   "start": 26.091,
   "end": 27.113,
   "text": "Keduanya dibandingkan. Itulah analisisnya."
  },
  {
   "start": 28.023,
   "end": 32.013,
   "text": "Pertanyaan berbeda menuntut rancangan berbeda."
  },
  {
   "start": 32.873,
   "end": 34.379,
   "text": "Ardipal: Pertanyaan kedua menguji pengaruh."
  },
  {
   "start": 35.909,
   "end": 37.148,
   "text": "Kamu perlu kelompok pembanding,"
  },
  {
   "start": 38.152,
   "end": 40.449,
   "text": "dan ukuran tempo sebelum serta sesudah latihan."
  },
  {
   "start": 41.546,
   "end": 44.221,
   "text": "Bukan «membuktikan», melainkan menguji perbedaan."
  },
  {
   "start": 45.642,
   "end": 47.648,
   "text": "Dalam satu sesi, Vidka memiliki tiga hal:"
  },
  {
   "start": 48.999,
   "end": 49.449,
   "text": "masalah yang jelas,"
  },
  {
   "start": 49.499,
   "end": 50.749,
   "text": "pertanyaan yang lengkap,"
  },
  {
   "start": 51.171,
   "end": 52.551,
   "text": "dan alasan memilih datanya."
  },
  {
   "start": 53.473,
   "end": 54.619,
   "text": "Rancangan penelitiannya siap."
  },
  {
   "start": 55.153,
   "end": 57.582,
   "text": "Tugas: pilih data untuk pertanyaanmu."
  },
  {
   "start": 58.447,
   "end": 59.247,
   "text": "Jelaskan alasannya."
  }
 ],
